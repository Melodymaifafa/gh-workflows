#!/bin/sh
# 只给**测试**用的 ps。为什么需要它、以及它为什么不放宽任何判定，见
# tests/test_helper/common.bash 里 scope_proc_sweep_to_this_run 的那段注释。
#
# 一句话：验证正文那道「按运行用户清点残留」问的是「这个 uid 名下有谁」，在 runner
# 上这等于「本次 run 自己起的有谁」（进程表干净），在本机上不等于 —— 同一个用户名下
# 还有隔壁 worker 的 `bats tests/`，以及 macOS 自己按需拉起来的一堆服务
# （networkserviceproxy、iCloudHelper、mdworker…）。这一份把答案收窄回 runner 上那个
# 意思：只答本次 run 自己的进程。
#
# 「本次 run 自己的」按三条认，缺一条这道门就在本机上失效：
#   1. 调用 ps 的那条祖先链（bats → 这一步的 shell → …）。
#   2. 链上任何一个进程的后代 —— 验证命令和它还连着的子孙都在这里。
#   3. argv 里带本次 run 临时目录的（$BATS_RUN_TMPDIR）。逃逸的残留靠这一条：它
#      setsid 换了会话、关光了描述符、被过继给 init，父子链上认不回来了，但它跑的
#      还是本次 run 临时目录下那个探针脚本。探针故意写成「从一个带路径的文件起」
#      就是为了这条认得出它 —— 认不出就等于清点看不见它，那几条「必须红」的测试
#      会假绿，所以它们本身就是这条规则的自测。
#
# GHWF_SWEEP_REAL_PS / GHWF_SWEEP_SELF / GHWF_SWEEP_RUN_TAG 只给 tests/harness.bats
# 那几条用：进程表、「我们是谁」、本次标记全喂死，于是那几条在哪台机器上都是同一个
# 答案，不靠真实 pid 撞不撞上表里的号码。

# 真正的 ps 只认绝对路径：这个目录就在 PATH 最前面，退回去按名字找会找回自己，
# 变成无限递归。一个都找不到就红着停下 —— 清点问不出来，而静默空转比红了更糟。
real="${GHWF_SWEEP_REAL_PS:-}"
if [ -z "$real" ]; then
  for candidate in /bin/ps /usr/bin/ps; do
    [ -x "$candidate" ] || continue
    real="$candidate"
    break
  done
fi
if [ ! -x "$real" ]; then
  echo "sweep-bin/ps: no real ps found; refusing to answer the sweep" >&2
  exit 2
fi

# 只有「按 uid 全机清点」那一种调用会数到别人（`ps -U <uid>`）。按进程组那一下
# （`ps -e -o pgid=…`）本来就只看我们自己那个组号，原样放过。
scoped=''
for arg in "$@"; do
  [ "$arg" = "-U" ] && scoped=1
done
[ -n "$scoped" ] || exec "$real" "$@"

status=0
out="$("$real" "$@")" || status=$?
# 全机快照问不出来就什么都不筛：宁可把今天的噪声留着，也不要悄悄少报一个残留。
# -ww 不许截断命令行：Linux 的 ps 在不是终端的时候按 80 列裁，裁掉探针脚本的路径
# 就等于认不出它是本次 run 的（本机不截断，看不出来）。
snap="$("$real" -A -ww -o pid=,ppid=,args= 2>/dev/null)" || snap=''
if [ -z "$snap" ] || [ -z "$out" ]; then
  [ -z "$out" ] || printf '%s\n' "$out"
  exit "$status"
fi

# 筛完的答案先接住再交出去，不直接写 stdout：筛选本身要是挂了（awk 不在、输入噎着
# 它），直接写就等于交出一份空的或半截的清点 —— 而「空」正是放行条件，这道门于是
# 静默变成空操作。接住之后筛选挂了就原样交出未筛的那一份：噪声回来、并发重新变红，
# 看得见、好诊断；静默假绿看不见。
filtered="$({
  printf '%s\n' "$snap" | sed 's/^/S|/'
  printf '%s\n' "$out" | sed 's/^/O|/'
} | awk -v self="${GHWF_SWEEP_SELF:-$PPID}" \
      -v tag="${GHWF_SWEEP_RUN_TAG-${BATS_RUN_TMPDIR-}}" '
    substr($0, 1, 2) == "S|" {
      line = substr($0, 3)
      n = split(line, f, " ")
      p = f[1]
      parent[p] = f[2]
      a = ""
      for (i = 3; i <= n; i++) a = a " " f[i]
      cmd[p] = a
      seen[++np] = p
      next
    }
    substr($0, 1, 2) == "O|" { asked[++no] = substr($0, 3); next }
    END {
      # 1. 调用 ps 的那条祖先链
      p = self; hops = 0
      while (p != "" && p != "0" && p != "1" && hops < 64) {
        root[p] = 1
        p = parent[p]
        hops++
      }
      # 3. argv 里带本次 run 临时目录的（逃逸的残留靠这一条认回来）
      if (tag != "") {
        for (i = 1; i <= np; i++) {
          p = seen[i]
          if (index(cmd[p], tag) > 0) root[p] = 1
        }
      }
      # 2. 上面那些的后代
      for (i = 1; i <= np; i++) {
        p = seen[i]; q = p; hops = 0
        while (q != "" && q != "0" && q != "1" && hops < 64) {
          if (q in root) { ours[p] = 1; break }
          q = parent[q]
          hops++
        }
      }
      for (i = 1; i <= no; i++) {
        split(asked[i], g, " ")
        if (g[1] in ours) print asked[i]
      }
    }')" || {
  echo 'sweep-bin/ps: the filter failed; answering with the unfiltered sweep' >&2
  printf '%s\n' "$out"
  exit "$status"
}
[ -z "$filtered" ] || printf '%s\n' "$filtered"
exit "$status"

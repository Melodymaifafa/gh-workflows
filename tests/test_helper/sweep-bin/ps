#!/bin/sh
# 只给**测试**用的 ps。为什么需要它、以及它为什么不放宽任何判定，见
# tests/test_helper/common.bash 里 scope_proc_sweep_to_this_run 的那段注释。
#
# 验证正文那道「按运行用户清点残留」问的是「这个 uid 名下有谁」。在 runner 上这等于
# 「本次 run 自己起的有谁」（进程表干净）；本机上不等于 —— 同一个用户名下还有隔壁
# worker 的 `bats tests/`，和 macOS 自己按需拉起来的服务。这一份把那两类的答案去掉。
#
# 方向很重要：**只去掉认得出是别人的**，不是「只留认得出是我们的」。两者的失败方向
# 相反 ——
#   · 只留我们的：哪天认不出自己的探针（它故意换了会话、关光了描述符、被过继给
#     init），清点就看不见它，那几条「必须红」的测试当场假绿，而假绿看不见。实测
#     踩过两次。
#   · 只去掉别人的：认不出就留着，于是噪声回来、并发重新变红 —— 看得见、好诊断，
#     而且原来那个「噪声重跑」还在兜。
# 所以下面先尽力把「本次 run 自己的」认出来（这些永远答），再把「positively 是别人的」
# 去掉（别人的 bats run、OS 自带目录里的进程，以及挂在它们底下的），剩下认不出主人的
# 一律照答。
#
# 另一个用户的 uid 一律原样放过：那是 runner 上那个专用账号（MEL-289），它名下本来
# 一个进程都没有，收窄只会把「清点看得见它」那道正面自测弄假。
#
# GHWF_SWEEP_REAL_PS / GHWF_SWEEP_SELF / GHWF_SWEEP_RUN_TAG / GHWF_SWEEP_SELF_UID
# 只给 tests/harness.bats 那几条用：进程表、「我们是谁」、本次标记、uid 全喂死，于是
# 那几条在哪台机器上都是同一个答案，不靠真实 pid 撞不撞上表里的号码。

# 真正的 ps 只认绝对路径：这个目录就在 PATH 最前面，退回去按名字找会找回自己，
# 变成无限递归。一个都找不到就红着停下 —— 清点问不出来，而静默空转比红了更糟。
real="${GHWF_SWEEP_REAL_PS:-}"
if [ -z "$real" ]; then
  for candidate in /bin/ps /usr/bin/ps; do
    [ -x "$candidate" ] || continue
    real="$candidate"
    break
  done
fi
if [ ! -x "$real" ]; then
  echo "sweep-bin/ps: no real ps found; refusing to answer the sweep" >&2
  exit 2
fi

# 只有「按**我们自己这个 uid** 全机清点」那一种调用会数到外人。按进程组那一下
# （`ps -e -o pgid=…`）只看我们自己那个组号；问别的 uid 的是专用账号那条路。两种
# 都原样放过。
scoped=''
want_uid=''
for arg in "$@"; do
  if [ -n "$scoped" ] && [ -z "$want_uid" ]; then want_uid="$arg"; fi
  [ "$arg" = "-U" ] && scoped=1
done
self_uid="${GHWF_SWEEP_SELF_UID:-$(id -u)}"
[ -n "$scoped" ] && [ "$want_uid" = "$self_uid" ] || exec "$real" "$@"

status=0
out="$("$real" "$@")" || status=$?
# 全机快照问不出来就什么都不筛：宁可把今天的噪声留着，也不要悄悄少报一个残留。
# -ww 不许截断命令行：Linux 的 ps 在不是终端的时候按 80 列裁，裁掉路径就等于认错
# 主人（本机不截断，看不出来）。
snap="$("$real" -A -ww -o pid=,ppid=,args= 2>/dev/null)" || snap=''
if [ -z "$snap" ] || [ -z "$out" ]; then
  [ -z "$out" ] || printf '%s\n' "$out"
  exit "$status"
fi

# 筛完的答案先接住再交出去，不直接写 stdout：筛选本身要是挂了，直接写就等于交出一份
# 空的或半截的清点 —— 而「空」正是放行条件，这道门于是静默变成空操作。
filtered="$({
  printf '%s\n' "$snap" | sed 's/^/S|/'
  printf '%s\n' "$out" | sed 's/^/O|/'
} | awk -v self="${GHWF_SWEEP_SELF:-$PPID}" \
      -v tag="${GHWF_SWEEP_RUN_TAG-${BATS_RUN_TMPDIR-}}" '
    substr($0, 1, 2) == "S|" {
      line = substr($0, 3)
      n = split(line, f, " ")
      p = f[1]
      parent[p] = f[2]
      a = ""
      for (i = 3; i <= n; i++) a = a " " f[i]
      cmd[p] = a
      seen[++np] = p
      next
    }
    substr($0, 1, 2) == "O|" { asked[++no] = substr($0, 3); next }

    function mine(p) { return (tag != "" && index(cmd[p], tag) > 0) }

    # positively 是别人的，三类：
    #   · 别人那次 bats run 的临时目录（我们自己那个先排掉）、bats 自己的那几个 exec
    #     程序 —— 隔壁 worker 整棵树，连它放出去的探针。
    #   · macOS 自己那些目录里的进程（按需拉起来的服务就在这儿）。
    #   · 任何从 .app 包里跑起来的进程（Chrome 的渲染进程、Electron 应用…）。
    # 这份名单只会认错一个方向：少认一类，那类噪声回来、并发重新变红，看得见；
    # 它不可能让清点少报我们自己的探针 —— 测试从不把这些目录里的东西留成后台进程。
    function elsewhere(p) {
      if (mine(p)) return 0
      if (index(cmd[p], "/bats-run-") > 0) return 1
      if (index(cmd[p], "/libexec/bats-core/") > 0) return 1
      if (index(cmd[p], ".app/Contents/") > 0) return 1
      if (cmd[p] ~ /^ (\/System\/|\/Library\/|\/Applications\/|\/usr\/libexec\/|\/usr\/sbin\/|\/sbin\/)/) return 1
      return 0
    }

    END {
      # ① 本次 run 自己的：跑这一步的 shell（argv 里带本次临时目录）、它到这里之间
      #    的几层子 shell、所有带本次标记的进程，以及它们的后代。往上走到第一个不带
      #    标记的祖先就停，**绝不**一路走到 1 号进程 —— 走上去会碰到「我们和隔壁
      #    共同的那个祖先」，于是隔壁整棵树都被算成我们的（实测踩过）。
      p = self; hops = 0; found = 0
      while (p != "" && p != "0" && p != "1" && hops < 64) {
        m = mine(p)
        if (found && !m) break
        root[p] = 1
        if (m) found = 1
        p = parent[p]
        hops++
      }
      for (i = 1; i <= np; i++) { p = seen[i]; if (mine(p)) root[p] = 1 }
      for (i = 1; i <= np; i++) {
        p = seen[i]; q = p; hops = 0
        while (q != "" && q != "0" && q != "1" && hops < 64) {
          if (q in root) { ours[p] = 1; break }
          q = parent[q]
          hops++
        }
      }
      # ② 别人的：上面那几条认出来的，加上挂在它们底下的
      for (i = 1; i <= np; i++) { p = seen[i]; if (!(p in ours) && elsewhere(p)) alien[p] = 1 }
      for (i = 1; i <= np; i++) {
        p = seen[i]
        if (p in ours) continue
        q = p; hops = 0
        while (q != "" && q != "0" && q != "1" && hops < 64) {
          if (q in alien) { hide[p] = 1; break }
          q = parent[q]
          hops++
        }
      }
      # ③ 认不出主人的照答
      for (i = 1; i <= no; i++) {
        split(asked[i], g, " ")
        if (g[1] in hide) continue
        print asked[i]
      }
    }')" || {
  echo 'sweep-bin/ps: the filter failed; answering with the unfiltered sweep' >&2
  printf '%s\n' "$out"
  exit "$status"
}
[ -z "$filtered" ] || printf '%s\n' "$filtered"
exit "$status"

#!/bin/sh
# 只给**测试**用的 ps。为什么需要它、以及它为什么不放宽任何判定，见
# tests/test_helper/common.bash 里 scope_proc_sweep_to_this_run 的那段注释。
#
# 一句话：验证正文那道「按运行用户清点残留」问的是「这个 uid 名下有谁」，在 runner
# 上这等于「本次 run 自己起的有谁」（进程表干净），在本机上不等于 —— 同一个用户名下
# 还有隔壁 worker 的 `bats tests/`，以及 macOS 自己按需拉起来的服务
# （networkserviceproxy、iCloudHelper、mdworker…）。这一份把答案收窄回 runner 上那个
# 意思：只答本次 run 自己的进程。
#
# 「本次 run 自己的」按三条认，缺一条这道门就在本机上失效：
#   1. 跑这一步的那个 shell，以及它到调用 ps 之间的那几层子 shell。认法是「argv 里
#      带本次 run 的临时目录」—— 那个 shell 跑的就是该目录下的步骤脚本。往上走到
#      第一个不带标记的祖先就停（那是 bats 自己），**绝不**一路走到 1 号进程：走上去
#      就会碰到「我们和隔壁 worker 共同的那个祖先」，于是隔壁整棵树都被算成我们的，
#      筛选变成空操作（实测踩过）。
#   2. argv 里带本次 run 临时目录的其它进程。逃逸的残留靠这一条：它 setsid 换了会话、
#      关光了描述符、被过继给 init，父子链上认不回来了，但它跑的还是本次 run 临时
#      目录下那个探针脚本。探针故意写成「从一个带路径的文件起」就是为了这条认得出
#      它 —— 认不出就等于清点看不见它，那几条「必须红」的测试会假绿，所以它们本身
#      就是这条规则的自测。
#   3. 上面那些的后代 —— 验证命令和它还连着的子孙都在这里。
#
# 另一个用户的 uid 一律原样放过：那是 runner 上那个专用账号（MEL-289），它名下本来
# 一个进程都没有，收窄只会把「清点看得见它」那道正面自测弄假。
#
# GHWF_SWEEP_REAL_PS / GHWF_SWEEP_SELF / GHWF_SWEEP_RUN_TAG / GHWF_SWEEP_SELF_UID
# 只给 tests/harness.bats 那几条用：进程表、「我们是谁」、本次标记全喂死，于是那几条
# 在哪台机器上都是同一个答案，不靠真实 pid 撞不撞上表里的号码。

# 真正的 ps 只认绝对路径：这个目录就在 PATH 最前面，退回去按名字找会找回自己，
# 变成无限递归。一个都找不到就红着停下 —— 清点问不出来，而静默空转比红了更糟。
real="${GHWF_SWEEP_REAL_PS:-}"
if [ -z "$real" ]; then
  for candidate in /bin/ps /usr/bin/ps; do
    [ -x "$candidate" ] || continue
    real="$candidate"
    break
  done
fi
if [ ! -x "$real" ]; then
  echo "sweep-bin/ps: no real ps found; refusing to answer the sweep" >&2
  exit 2
fi

# 只有「按**我们自己这个 uid** 全机清点」那一种调用会数到外人。按进程组那一下
# （`ps -e -o pgid=…`）只看我们自己那个组号；问别的 uid 的是专用账号那条路。两种
# 都原样放过。
scoped=''
want_uid=''
for arg in "$@"; do
  if [ -n "$scoped" ] && [ -z "$want_uid" ]; then want_uid="$arg"; fi
  [ "$arg" = "-U" ] && scoped=1
done
self_uid="${GHWF_SWEEP_SELF_UID:-$(id -u)}"
[ -n "$scoped" ] && [ "$want_uid" = "$self_uid" ] || exec "$real" "$@"

status=0
out="$("$real" "$@")" || status=$?
# 全机快照问不出来就什么都不筛：宁可把今天的噪声留着，也不要悄悄少报一个残留。
# -ww 不许截断命令行：Linux 的 ps 在不是终端的时候按 80 列裁，裁掉探针脚本的路径
# 就等于认不出它是本次 run 的（本机不截断，看不出来）。
snap="$("$real" -A -ww -o pid=,ppid=,args= 2>/dev/null)" || snap=''
if [ -z "$snap" ] || [ -z "$out" ]; then
  [ -z "$out" ] || printf '%s\n' "$out"
  exit "$status"
fi

# 筛完的答案先接住再交出去，不直接写 stdout：筛选本身要是挂了（awk 不在、输入噎着
# 它、或者压根没找到本次 run 的标记），直接写就等于交出一份空的或半截的清点 ——
# 而「空」正是放行条件，这道门于是静默变成空操作。接住之后筛不出来就原样交出未筛的
# 那一份：噪声回来、并发重新变红，看得见、好诊断；静默假绿看不见。
filtered="$({
  printf '%s\n' "$snap" | sed 's/^/S|/'
  printf '%s\n' "$out" | sed 's/^/O|/'
} | awk -v self="${GHWF_SWEEP_SELF:-$PPID}" \
      -v tag="${GHWF_SWEEP_RUN_TAG-${BATS_RUN_TMPDIR-}}" '
    substr($0, 1, 2) == "S|" {
      line = substr($0, 3)
      n = split(line, f, " ")
      p = f[1]
      parent[p] = f[2]
      a = ""
      for (i = 3; i <= n; i++) a = a " " f[i]
      cmd[p] = a
      seen[++np] = p
      next
    }
    substr($0, 1, 2) == "O|" { asked[++no] = substr($0, 3); next }
    END {
      if (tag == "") exit 1
      # 1. 跑这一步的那个 shell 和它到这里之间的几层子 shell。走到第一个不带标记的
      #    祖先就停，别往共同祖先上走。
      p = self; hops = 0; found = 0
      while (p != "" && p != "0" && p != "1" && hops < 64) {
        mark = (index(cmd[p], tag) > 0)
        if (found && !mark) break
        root[p] = 1
        if (mark) found = 1
        p = parent[p]
        hops++
      }
      # 一个带标记的祖先都没有 = 这不是本次 run 的那一步在问，筛不出来。
      if (!found) exit 1
      # 2. 带标记的其它进程（逃逸的残留靠这一条认回来）
      for (i = 1; i <= np; i++) {
        p = seen[i]
        if (index(cmd[p], tag) > 0) root[p] = 1
      }
      # 3. 上面那些的后代
      for (i = 1; i <= np; i++) {
        p = seen[i]; q = p; hops = 0
        while (q != "" && q != "0" && q != "1" && hops < 64) {
          if (q in root) { ours[p] = 1; break }
          q = parent[q]
          hops++
        }
      }
      for (i = 1; i <= no; i++) {
        split(asked[i], g, " ")
        if (g[1] in ours) print asked[i]
      }
    }')" || {
  echo 'sweep-bin/ps: cannot tell this run apart; answering with the unfiltered sweep' >&2
  printf '%s\n' "$out"
  exit "$status"
}
[ -z "$filtered" ] || printf '%s\n' "$filtered"
exit "$status"
